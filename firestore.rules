rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dueño de respaldo — nunca queda bloqueado aunque se borre la colección
    // usuariosPermitidos por error. El resto de usuarios se gestiona desde
    // la propia app (panel Usuarios), sin tocar código ni redesplegar reglas.
    function esDueno() {
      return request.auth != null && request.auth.token.email == "makeuptosha@gmail.com";
    }
    function autorizado() {
      return request.auth != null && (
        esDueno() ||
        exists(/databases/$(database)/documents/usuariosPermitidos/$(request.auth.token.email))
      );
    }

    // Perfiles privados: cada documento le pertenece al usuario que lo creó
    // (campo `uid`). Solo su dueño puede leerlo/editarlo/borrarlo, y solo
    // puede crear documentos a su propio nombre.
    function esPropio() {
      return autorizado() && resource.data.uid == request.auth.uid;
    }
    function creaComoPropio() {
      return autorizado() && request.resource.data.uid == request.auth.uid;
    }

    match /usuariosPermitidos/{email} {
      allow read, write: if autorizado();
    }

    match /cuentas/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /movimientos/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /categorias/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /facturasRecurrentes/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /pagosFactura/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /presupuestos/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /deudas/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /metas/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /borradores/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }
    match /notas/{docId} {
      allow read, update, delete: if esPropio();
      allow create: if creaComoPropio();
    }

    // Todo lo demás (colecciones viejas de Tosha u otras) queda bloqueado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
